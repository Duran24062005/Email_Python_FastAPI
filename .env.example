# App configuration
PORT=
HOST=
ENVIRONMENT=production  # development | production
DOMAIN=http://127.0.0.1:8000/
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://swift-mailer.vercel.app

# Configuración SMTP para envío de emails
# Para Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password


# Recommended for most uses
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=localhost
PGHOST_UNPOOLED=
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=123456
PGPORT=5432
PGSSLMODE=require

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
