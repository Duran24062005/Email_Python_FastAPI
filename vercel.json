{
    "version": 2,
    "buildCommand": "pip install -r requirements.txt",
    "builds": 
    [
        {
            "src": "main.py",
            "use": "@vercel/python",
            "config": 
            {
                "maxLambdaSize": "50mb",
                "runtime": "python3.11"
            }
        }
    ],
    "routes": 
    [
        {
            "src": "/public/(.*)",
            "dest": "/public/$1",
            "methods": 
            [
                "GET",
                "HEAD"
            ]
        },
        {
            "src": "/static/(.*)",
            "dest": "/static/$1",
            "methods": 
            [
                "GET",
                "HEAD"
            ]
        },
        {
            "src": "/(.*)",
            "dest": "main.py",
            "methods": 
            [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS",
                "HEAD"
            ]
        }
    ],
    "env": 
    {
        "ENVIRONMENT": "production",
        "PYTHONUNBUFFERED": "1"
    },
    "envFile": ".env.production"
}