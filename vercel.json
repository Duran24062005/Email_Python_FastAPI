{
    "version": 2,
    "builds": 
    [
        {
            "src": "main.py",
            "use": "@vercel/python"
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": 
    [
        {
            "src": "/public/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "app/main.py"
        }
    ],
    "env": 
    {
        "ENVIRONMENT": "production"
    }
}